// 4. Full Name + Average Grade
db.students.aggregate([
  {
    $project: {
      _id: 0,
      FullName: {
        $concat: ["$FirstName", " ", "$LastName"]
      },
      AverageGrade: { $avg: "$Courses.FinalMark" }
    }
  }
])

// 5. Student + Faculty
db.students.aggregate([
  {
    $lookup: {
      from: "faculty",
      localField: "FacultyId",
      foreignField: "_id",
      as: "Faculty"
    }
  },
  { $unwind: "$Faculty" }
])
