{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",

    "strict": true,

    "sourceMap": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "skipLibCheck": true
  },

  "include": ["src/**/*"]
}